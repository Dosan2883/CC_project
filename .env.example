# 로컬: sqlite / Learner Lab: dynamodb
DATA_BACKEND=sqlite
# 비우면 프로젝트의 data/ 사용
# DATA_DIR=/var/lib/messenger

# AWS 모드에서는 모든 채팅 서버/워커가 같은 값을 사용
# 서버 한 대로 DynamoDB와 S3만 쓰려면 SINGLE_NODE=1 (SQS·Redis 없이 시작, 워커도 같은 프로세스).
# python -m scripts.setup_aws --table 이름 --bucket 이름 --write-env 가 아래 값을 .env에 써 준다.
SINGLE_NODE=0
AWS_REGION=us-east-1
DYNAMODB_TABLE=
S3_BUCKET=
MEDIA_QUEUE_URL=
REDIS_URL=
AUTH_SECRET=

# 번역: AWS Lambda 함수 URL과 공유 비밀 값. 비우면 번역 기능만 꺼집니다.
# 실제 값은 .env(깃에 올라가지 않음)나 SSM 등에만 두고 이 파일에는 절대 적지 않는다.
TRANSLATE_URL=
TRANSLATE_SECRET=
# 사용자 한 명이 한 시간에 새로 요청할 수 있는 번역 횟수(캐시된 번역은 세지 않음)
TRANSLATE_HOURLY_LIMIT=60
AI_QUEUE_URL=
# Optional JSON by target language: {"ko":{"calls":60,"tokens":120000}}
AI_LANGUAGE_LIMITS={}

# 음성·영상 인식(Whisper를 서버 안에서 직접 실행, AWS 서비스 불필요)
#   whisper : 실제 인식. requirements-stt.txt 설치와 모델 준비(python -m scripts.prepare_stt)가 필요
#   fake    : 모델 없이 정해진 결과(로컬 개발·화면 확인용)
#   비움    : 음성·영상 파일은 올라가지만 처리 단계에서 STT_NOT_CONFIGURED로 실패
STT_BACKEND=
# 모델 크기(tiny/base/small/medium). 클수록 정확하지만 느리고 메모리를 더 쓴다
STT_MODEL=base
# 모델 파일 저장 위치(비우면 기본 캐시). 처리 가능한 최대 길이(초). 동시에 인식하는 개수
# STT_MODEL_DIR=/var/lib/messenger/whisper
STT_MAX_SECONDS=600
STT_CONCURRENCY=1
# 업로드 최대 크기(MB)
MAX_AUDIO_MB=30
MAX_VIDEO_MB=60

# AWS 채팅 서버는 0, 로컬 단일 프로세스 데모는 1
RUN_MEDIA_WORKER=1
# 자격 증명은 AWS 프로필/환경변수/EC2 인스턴스 프로필로 공급
# Learner Lab 임시 자격 증명에는 AWS_SESSION_TOKEN도 필요
