# 로컬: sqlite / Learner Lab: dynamodb
DATA_BACKEND=sqlite
# 비우면 프로젝트의 data/ 사용
# DATA_DIR=/var/lib/messenger

# AWS 모드에서는 모든 채팅 서버/워커가 같은 값을 사용
AWS_REGION=us-east-1
DYNAMODB_TABLE=
S3_BUCKET=
MEDIA_QUEUE_URL=
REDIS_URL=
AUTH_SECRET=

# AWS 채팅 서버는 0, 로컬 단일 프로세스 데모는 1
RUN_MEDIA_WORKER=1
# 자격 증명은 AWS 프로필/환경변수/EC2 인스턴스 프로필로 공급
# Learner Lab 임시 자격 증명에는 AWS_SESSION_TOKEN도 필요
